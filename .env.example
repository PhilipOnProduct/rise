# Rise — environment variables.
# Copy to `.env.local` (gitignored) and fill in real values.
# NEXT_PUBLIC_* are exposed to the browser; everything else is server-only.

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key — bypasses RLS, server-only. Required: loggers + admin
# endpoints throw without it. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Maps / Places ──────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_PLACES_KEY=your-google-places-key

# ── Access gates ──────────────────────────────────────────────────────────
# Whole-site password gate. Leave unset to disable.
SITE_PASSWORD=
# Gate for /admin/* routes. Unset = open in dev, DENIED in production.
ADMIN_PASSWORD=
